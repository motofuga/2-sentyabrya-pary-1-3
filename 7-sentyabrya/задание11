import sys

# Объявление класса StreamData
class StreamData:
    def create(self, fields, lst_values):
        # Проверяем, совпадает ли количество полей и значений
        if len(fields) != len(lst_values):
            return False
        
        # Создаем локальные свойства для каждого поля
        for i in range(len(fields)):
            setattr(self, fields[i], lst_values[i])
        
        return True

class StreamReader:
    FIELDS = ('id', 'title', 'pages')

    def readlines(self):
        lst_in = list(map(str.strip, sys.stdin.readlines()))  # считывание списка строк из входного потока
        sd = StreamData()
        res = sd.create(self.FIELDS, lst_in)
        return sd, res

# Создание объекта и вызов метода readlines()
sr = StreamReader()
data, result = sr.readlines()

# Вывод результатов для проверки
print(f"Результат создания: {result}")
if result:
    print(f"id: {data.id}")
    print(f"title: {data.title}")
    print(f"pages: {data.pages}")
else:
    print("Ошибка: количество полей и значений не совпадает")