# Объявление класса Graph
class Graph:
    LIMIT_Y = [0, 10]
    
    def set_data(self, data):
        self.data = data
    
    def draw(self):
        # Фильтруем числа, которые входят в диапазон LIMIT_Y
        filtered_data = [str(x) for x in self.data if self.LIMIT_Y[0] <= x <= self.LIMIT_Y[1]]
        print(' '.join(filtered_data))

# Создание объекта graph_1
graph_1 = Graph()

# Вызов метода set_data() с переданным списком
graph_1.set_data([10, -5, 100, 20, 0, 80, 45, 2, 5, 7])

# Вызов метода draw()
graph_1.draw()