# Объявление класса Person
class Person:
    name = 'Сергей Балакирев'
    job = 'Программист'
    city = 'Москва'

# Создание экземпляра p1
p1 = Person()

# Проверка наличия локального свойства job
print("Есть ли у p1 локальное свойство job?")
print(hasattr(p1, 'job'))

# Дополнительная проверка: посмотрим, что в __dict__
print(f"\nЛокальные свойства p1: {p1.__dict__}")

# Создадим локальное свойство job для демонстрации
p1.job = 'Тестировщик'
print(f"\nПосле добавления локального свойства job:")
print(f"Локальные свойства p1: {p1.__dict__}")
print(f"Есть ли у p1 локальное свойство job? {hasattr(p1, 'job')}")